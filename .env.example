# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"   # server-side only — never expose to browser
SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"            # alias for ANON_KEY

# Vite-exposed (client-side)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"

# ── AI ────────────────────────────────────────────────────────────────────────
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY="your_groq_api_key"                             # server-side only
# Optional override for image analysis. Leave unset to use Qwen 3.6 27B.
GROQ_VISION_MODEL="qwen/qwen3.6-27b"

# ── Seed script (optional) ────────────────────────────────────────────────────
SEED_USER_ID="your-supabase-auth-user-uuid"
SUPABASE_BUCKET_ID="wardrobe-images"
