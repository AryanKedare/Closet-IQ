# ── Appwrite ──────────────────────────────────────────────────────────────────
APPWRITE_PROJECT_ID="your_appwrite_project_id"
APPWRITE_DATABASE_ID="your_appwrite_database_id"
APPWRITE_BUCKET_ID="your_appwrite_bucket_id"
VITE_APPWRITE_PROJECT_ID="your_appwrite_project_id"
VITE_APPWRITE_DATABASE_ID="your_appwrite_database_id"
VITE_APPWRITE_BUCKET_ID="your_appwrite_bucket_id"

# ── Supabase ───────────────────────────────────────────────────────────────────
# Find these in your Supabase project → Settings → API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
# Service role key is only needed for the seed script (has write access)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_BUCKET_ID="wardrobe-images"

# ── Seed script ────────────────────────────────────────────────────────────────
# Your own Supabase auth user UUID — found in Supabase → Authentication → Users
SEED_USER_ID="your-supabase-user-uuid"

# ── AI (Groq) ─────────────────────────────────────────────────────────────────
# Required for AI outfit explanations — get your key at https://console.groq.com
GROQ_API_KEY="your_groq_api_key"
